# ---------------------------------------------------------------------------
# Gateway Skills Network — environment template
# Copy to apps/web/.env.local for local development.
# Never commit real values. All variables here are server-only.
# ---------------------------------------------------------------------------

# --- Lead storage --------------------------------------------------------
# "json" (default) writes to a file; "postgres" uses DATABASE_URL.
#
# IMPORTANT: json is for local work and a single long-lived server only. On
# Vercel, Lambda or any serverless host the filesystem is ephemeral and NOT
# shared between invocations, so enquiries written to it WILL be lost. Set
# LEAD_STORAGE="postgres" in production. /api/health reports which is in use
# and flags the unsafe combination.
LEAD_STORAGE="json"
# Where the json driver writes. Defaults to .data/leads.json in the app.
LEAD_STORE_FILE=""

# Postgres. Local Homebrew instance, or a Neon pooled connection string.
# Required when LEAD_STORAGE="postgres".
DATABASE_URL="postgresql://USER@localhost:5432/gateway_skills_dev"

# Public origin, used for canonicals, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:4321"

# --- Email (Resend) ------------------------------------------------------
# Without RESEND_API_KEY the lead still persists and its outbox row waits:
# nothing is lost, delivery is simply deferred until a key is configured.
RESEND_API_KEY=""
# Must be a verified sending domain in production. Until DNS is verified on
# gatewayskillsnetwork.co.uk, Resend's onboarding sender is used.
LEAD_NOTIFICATION_FROM="Gateway Skills Network <onboarding@resend.dev>"
# Fixed recipient. Never accepted from a request, never chosen by a model.
LEAD_NOTIFICATION_TO="info@gatewayskillsnetwork.co.uk"
# Signing secret for the Resend delivery webhook (whsec_...).
RESEND_WEBHOOK_SECRET=""

# --- Scheduled outbox drain ---------------------------------------------
# Shared secret for /api/cron/drain-outbox. Generate: openssl rand -hex 24
CRON_SECRET=""

# --- Admin dashboard (/admin) -------------------------------------------
# Both are required for /admin to open at all; without them the sign-in page
# reports that it is unconfigured rather than letting anyone in.
#
# Generate the hash (never store the password itself):
#   node apps/web/scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=""
# Signs the session cookie. Generate: openssl rand -hex 32
# Changing it invalidates every signed-in session, which is how you revoke one.
ADMIN_SESSION_SECRET=""

# --- Abuse controls ------------------------------------------------------
LEAD_RATE_LIMIT_PER_IP="5"
LEAD_RATE_LIMIT_GLOBAL="120"
# Admin sign-in is throttled on its own counters, deliberately separate from
# the public form: enquiry volume must never lock the team out of /admin.
ADMIN_RATE_LIMIT_PER_IP="10"
ADMIN_RATE_LIMIT_GLOBAL="60"
OUTBOX_MAX_ATTEMPTS="6"

# Optional: Cloudflare Turnstile. Left empty, the layered honeypot + timing +
# rate-limit defence applies and no third-party script is loaded.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
